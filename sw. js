const CACHE = 'aqm-v10.13.1-offline';
const ZX = 'https://unpkg.com/@zxing/library@0.20.0';
const PRECACHE = ['./', 'index.html'];

self.addEventListener('install', e => {
  e.waitUntil(
    caches.open(CACHE).then(async c => {
      await c.addAll(PRECACHE);
      try { const r = await fetch(ZX); if (r.ok) await c.put(ZX, r); } catch (err) {}
    }).then(() => self.skipWaiting())
  );
});

self.addEventListener('activate', e => {
  e.waitUntil(
    caches.keys()
      .then(keys => Promise.all(keys.filter(k => k !== CACHE).map(k => caches.delete(k))))
      .then(() => self.clients.claim())
  );
});

self.addEventListener('fetch', e => {
  const r = e.request;
  if (r.method !== 'GET') return;
  const u = new URL(r.url);

  // ZXing z unpkg: nejdřív cache, jinak síť a uložit
  if (r.url === ZX) {
    e.respondWith(caches.match(ZX).then(m => m || fetch(ZX).then(res => {
      if (res.ok) { const copy = res.clone(); caches.open(CACHE).then(c => c.put(ZX, copy)); }
      return res;
    })));
    return;
  }

  // Vlastní soubory: okamžitě z cache, na pozadí aktualizace
  if (u.origin !== location.origin) return;
  e.respondWith(
    caches.match(r, { ignoreSearch: true }).then(cached => {
      const net = fetch(r).then(res => {
        if (res && res.ok) { const copy = res.clone(); caches.open(CACHE).then(c => c.put(r, copy)); }
        return res;
      }).catch(() => cached || caches.match('index.html'));
      return cached || net;
    })
  );
});
